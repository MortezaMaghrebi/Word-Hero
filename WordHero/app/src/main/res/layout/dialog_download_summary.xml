<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/curve_dialog_download_progress"
    android:padding="20dp"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="لغت‌ها به درستی دریافت شدند. بریم برای دانلود تصاویر؟"
        android:textSize="20sp"
        android:textColor="#000000"
        android:fontFamily="@font/yekan"
        android:textDirection="rtl"
        android:textAlignment="viewStart"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="#000000"
        android:fontFamily="@font/yekan"
        android:textDirection="rtl"
        android:textAlignment="viewStart"
        android:lineSpacingExtra="4sp"/>

    <RelativeLayout
        android:layout_width="230dp"
        android:layout_height="54dp"
        android:id="@+id/lytok"
        android:background="@drawable/outline_button1"
        android:layout_centerHorizontal="true"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="دانلود تصاویر"
            android:fontFamily="@font/yekan"
            android:textColor="#be6275"
            android:textSize="25dp"
            android:gravity="center"
            android:textStyle="bold"
            android:layout_centerInParent="true"
            />
    </RelativeLayout>
</LinearLayout>